      const scoredUsers = users.filter(u => u.lastExamScore !== null)
      const avgScore = scoredUsers.length
        ? Math.round(scoredUsers.reduce((s, u) => s + (u.lastExamScore ?? 0), 0) / scoredUsers.length)
